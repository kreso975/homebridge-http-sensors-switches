{
  "name": "homebridge-http-sensors-switches",
  "displayName": "Http Sensors and Switches",
  "type": "module",
  "version": "1.5.1",
  "private": false,
  "description": "This plugin communicates with your devices over HTTP or MQTT. Currently it supports Light Bulb, Switches, Outlets, Fan, Temperature/Humidity and Motion sensor. Simple Discord Webhooks available in Light Bulb, Switches and Outlets.",
